<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChronoStudy" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black_oled</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.ChronoStudy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black_oled</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_chrono_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ChronoStudy</item>
    </style>
</resources>
